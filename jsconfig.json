{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/components/**/*.js",
    "src/pages/**/*.jsx",
    "src/Layout.jsx"
  ],
  "//": "Test files run under Vitest, which loads and validates them at runtime and pulls in test-runner-only deps; they are intentionally not part of this app type-check.",
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/components/ui",
    "src/api",
    "src/lib",
    "src/test",
    "**/*.test.js",
    "**/*.test.jsx"
  ]
}