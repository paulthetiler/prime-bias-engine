# PrimeBias Engine — environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). Then restart `npm run dev`.
#
# Both values are safe to expose to the browser: the anon/public key is designed
# to be shipped to clients and is protected by Row Level Security (see
# supabase/migrations/0001_init.sql). Never put your service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
